# Application
NEXT_PUBLIC_APP_NAME=DittoPDF
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dittopdf?schema=public

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# JWT
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Password
PASSWORD_SALT_ROUNDS=12

# File Storage
NEXT_PUBLIC_STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# File Limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX=100
PDF_PROCESSING_LIMIT=5

# Ad Monetization
NEXT_PUBLIC_GOOGLE_ADSENSE_PUBLISHER_ID=pub-1234567890123456
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_ID=1234567890

# Email
EMAIL_FROM=no-reply@dittopdf.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@example.com
EMAIL_SMTP_PASSWORD=your-email-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLIC_KEY=your-stripe-public-key

# Recaptcha
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Logging
LOG_LEVEL=info